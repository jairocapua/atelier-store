# Neon Postgres — the pooled connection string from your Neon project dashboard.
# Neon shows it under "Connection string"; keep `-pooler` in the host and
# `?sslmode=require` on the end.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Better Auth signing secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Public origin of the app. Used as the Better Auth baseURL on both the server
# and the client, so it must match the URL you actually load in the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
